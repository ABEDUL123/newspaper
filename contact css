*{
    box-sizing: border-box;
    padding: 0;
    margin: 0;
}
body{
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 90vh;
}
.form{
    padding: 30px;
    background-color: #9db4c3;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
    border-radius: 5px;
}
h3{
    text-align: center;
    padding: 10px;
    color: #fff;
}
input,textarea{
    width: 250px;
    display: block;
    padding: 10px;
    border-radius: 3px;
    font-size: 12px;
    margin: 15px;
    border: 0;
    outline: none;
}
#btn{
    padding: 10px;
    margin: 15px;
    width: 250px;
    border: 0;
    border-radius: 5px;
    background-color: #1e90ff;
    color: #fff;
    cursor: pointer;
}
